# Copy to .env and change the values. Do not commit .env.
APP_PORT=3000
POSTGRES_USER=dockerwatch
# Avoid special characters (@ : /) in the password. The password is part of a URL.
POSTGRES_PASSWORD=ganti_password_dummy
POSTGRES_DB=dockerwatch
CACHE_TTL_SECONDS=5

# Discord crash alerting (bonus feature - PRD section 17)
# Paste your webhook URL from Discord (Server Settings > Integrations > Webhooks)
DISCORD_WEBHOOK_URL=
# true = send alerts automatically when a container crashes (event "die")
# false = send manually via the Discord button in the Snapshots drawer
DISCORD_AUTO_ALERT=false

# Environment label for the Discord embed footer (e.g. LOCAL-DEV / PROD-VPS)
SERVER_ENV=LOCAL-DEV
